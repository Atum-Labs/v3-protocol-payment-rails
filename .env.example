# ============================================
# Payment Rails — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] are needed for basic forge test / fork tests.
# Variables marked [DEPLOY] are only needed for deployment scripts.
# Variables marked [OPTIONAL] have sensible defaults in the scripts.

# ============================================
# RPC URLs
# ============================================
# [REQUIRED] Needed for fork tests and mainnet scripts
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# [REQUIRED] Needed for the Avalanche fork tests; this public endpoint needs no API key.
# Avalanche fork tests skip when this is unset.
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# [OPTIONAL] Testnets — public RPCs work fine
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# [OPTIONAL] Used by CCTP bridge scripts (source/dest chain RPCs)
SOURCE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEST_RPC_URL=https://sepolia.base.org

# ============================================
# Deployment Account
# ============================================
# [DEPLOY] Deployer ADDRESS — public, safe to store here. Base.s.sol uses it as the broadcaster.
# Supply the signer at deploy time with --ledger, --trezor, or --account <keystore>:
#   cast wallet import cc-deployer --interactive          # once; stores the key encrypted
#   ETH_FROM=0x... forge script ... --account cc-deployer --broadcast
# Never put a private key or mnemonic in this file. The test mnemonic's addresses carry EIP-7702
# delegations on live chains — anything sent to them is forwarded away on arrival — and Base.s.sol
# refuses to broadcast from it on any chain but a local node.
# ETH_FROM=0xYOUR_DEPLOYER_ADDRESS

# ============================================
# Block Explorer API Keys (contract verification)
# ============================================
# [DEPLOY] Get from: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ============================================
# Deployed Contract Addresses
# ============================================
# [OPTIONAL] Set after deploying — used by smoke/dry-run scripts
# PAYMENT_RAILS_ADDRESS=0x...
# MODULE_ADDRESS=0x...
# BRIDGE_MODULE=0x...

# ============================================
# Forward Module Parameters
# ============================================
# [OPTIONAL] Override defaults in Forward smoke/dry-run scripts
# TOKEN=0x...
# AMOUNT=1000000
# RECIPIENT=0x...
# MIN_AMOUNT=0

# ============================================
# DexSwap Module Parameters
# ============================================
# [OPTIONAL] Override defaults in DexSwap smoke/dry-run scripts
# Uniswap SwapRouter02 — chain-specific, and NOT the original SwapRouter:
#   ethereum / arbitrum / optimism / polygon  0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
#   base                                      0x2626664c2603336E57B271c5C0b26F421741e481
#   avalanche                                 0xbb00FF08d01D300023C629E8fFfFcb65A5a578cE
# ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
# SELL_TOKEN=0x...
# BUY_TOKEN=0x...
# SELL_AMOUNT=1000000
# MAX_SLIPPAGE_BPS=500
# POOL_FEE=500
# MAX_STALENESS=3600
# SWAP_DEADLINE=300

# ============================================
# CowSwap Module Parameters
# ============================================
# [OPTIONAL] Override defaults in CowSwap smoke/dry-run scripts
# COWSWAP_API=https://api.cow.fi/base
# SELL_TOKEN=0x...
# BUY_TOKEN=0x...
# SELL_AMOUNT=1000000
# MIN_BUY_AMOUNT=900000
# VALIDITY_DURATION=3600

# ============================================
# CCTP Bridge Module Parameters
# ============================================
# [OPTIONAL] Override defaults in CCTP bridge scripts
# TOKEN_MESSENGER_V2=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
# SOURCE_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# DEST_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# SOURCE_DOMAIN=0
# DEST_DOMAIN=6
# BRIDGE_AMOUNT=10000000
# MIN_BALANCE=1000000
# MAX_FEE=0
# FINALITY=2000
# MINT_RECIPIENT=0x...

# [OPTIONAL] Circle attestation API (testnet or mainnet)
# IRIS_API=https://iris-api-sandbox.circle.com
# SOURCE_TX_HASH=0x...

# ============================================
# Foundry Profile
# ============================================
FOUNDRY_PROFILE=default
